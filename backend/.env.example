# Server configuration
PORT=8000
HOST=127.0.0.1

# Database configuration
DATABASE_URL=sqlite:///./lifesync.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Groq API Configuration (Get free API key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b

# Google OAuth Configuration (Google Cloud Console OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback

# Session JWT Secret
JWT_SECRET_KEY=your_jwt_secret_key_here

# Frontend URL
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
