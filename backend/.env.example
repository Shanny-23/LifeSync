# Server configuration
PORT=8000
HOST=127.0.0.1

# Database configuration
# SQLite default for local development. For Postgres: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./lifesync.db

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Google Gemini API Configuration (obtain from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

